{
  "manifest_version": 3,
  "name": "Panadolce - Trợ Lý Học Thuật & Đa Nhiệm",
  "version": "2.5.2",
  "description": "Panadolce: Advanced academic assistant & multi-tasking workspace — International citations IEEE/APA/Harvard/MLA/BibTeX, smart media player, privacy redaction and AI assistant.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "cookies",
    "bookmarks",
    "contextMenus",
    "browsingData",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "OS/js/content/i18n.js",
        "OS/js/content/inspect.js",
        "OS/js/content/snip.js",
        "OS/js/content/scroll.js",
        "OS/js/content/citation.js",
"OS/js/content/security.js",
        "OS/js/content/media.js",
        "OS/js/content/social.js",
        "OS/js/content/lingua.js",
        "OS/js/content/main.js"
      ],
      "css": [
        "OS/css/content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "OS/js/content/cookie_reject.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "OS/js/content/darkmode.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "OS/js/content/pomoMusicConfirm.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "OS/js/content/gamble-fp.js",
        "OS/js/content/gamble-scan.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "OS/html/popup.html",
    "default_title": "Panadolce"
  },
  "sidebar_action": {
    "default_panel": "OS/html/sidebar.html",
    "default_title": "Panadolce",
    "default_icon": "icon48.png"
  },
  "background": {
    "scripts": [
      "OS/js/background.js"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "panadolce-dev@thuantran520.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "OS/html/gamble-block.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
